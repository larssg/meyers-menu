{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meyers-menu",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "kv_namespaces": [
    {
      "binding": "MENU_KV",
      // Create with: wrangler kv namespace create MENU_KV
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],

  "triggers": {
    // Every 6 hours, matching the old MenuCacheBackgroundService refresh interval.
    "crons": ["17 */6 * * *"]
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    "SITE_URL": "https://menu.smartcode.dk"
  }

  // REFRESH_SECRET is set with: wrangler secret put REFRESH_SECRET
}
