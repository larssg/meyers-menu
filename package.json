{
  "name": "meyers-menu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run css:build && wrangler dev",
    "deploy": "npm run css:build && wrangler deploy",
    "css:build": "tailwindcss -i ./styles/app.css -o ./public/css/app.css --minify",
    "css:watch": "tailwindcss -i ./styles/app.css -o ./public/css/app.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260818.1",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "dependencies": {
    "hono": "^4.13.3"
  }
}
