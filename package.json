{
  "name": "meyers-menu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run css:build && wrangler dev",
    "deploy": "npm run css:build && wrangler deploy",
    "css:build": "tailwindcss -i ./styles/app.css -o ./public/css/app.css --minify",
    "css:watch": "tailwindcss -i ./styles/app.css -o ./public/css/app.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@tailwindcss/cli": "^4.3.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "engines": {
    "node": ">=22"
  }
}
